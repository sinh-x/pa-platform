{
  "name": "@pa-platform/pa-core",
  "version": "0.1.187",
  "type": "module",
  "description": "Runtime-agnostic core library for PA platform adapters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tickets/planned-actual": {
      "types": "./dist/tickets/planned-actual.d.ts",
      "import": "./dist/tickets/planned-actual.js"
    },
    "./runtime-api": {
      "types": "./dist/runtime-api/index.d.ts",
      "import": "./dist/runtime-api/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-security-policy.mjs && node scripts/build-public-web.mjs",
    "test": "node ../../scripts/dev/isolated-test-env.mjs -- corepack pnpm run test:run",
    "test:run": "node scripts/build-public-web.mjs && tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:source": "node ../../scripts/dev/isolated-test-env.mjs -- tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:code": "node ../../scripts/dev/isolated-test-env.mjs -- node ../../scripts/dev/run_code_tests.mjs pa-core",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/node-ws": "^1.2.0",
    "better-sqlite3": "13.0.3",
    "hono": "^4.12.18",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
}
