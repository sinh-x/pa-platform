{
  "name": "@pa-platform/pi-pa",
  "version": "0.1.88",
  "type": "module",
  "description": "Pi runtime adapter for the PA platform",
  "pi": {
    "extensions": ["./dist/pi-extension/index.js"]
  },
  "bin": {
    "ppa": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "corepack pnpm --filter @pa-platform/pa-core build && tsx --test \"src/**/*.test.ts\"",
    "typecheck": "corepack pnpm --filter @pa-platform/pa-core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pa-platform/pa-core": "workspace:*",
    "@pa-platform/opencode-pa": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
}
